# Database
AUTH_DATABASE_URL=postgresql://serein:serein_dev_password@localhost:5432/serein_auth
USER_DATABASE_URL=postgresql://serein:serein_dev_password@localhost:5432/serein_user
CONVERSATION_DATABASE_URL=postgresql://serein:serein_dev_password@localhost:5432/serein_conversation
CONTENT_DATABASE_URL=postgresql://serein:serein_dev_password@localhost:5432/serein_content
REDIS_URL=redis://localhost:6379

# Internal service URLs
USER_SERVICE_URL=http://localhost:3002
CONVERSATION_SERVICE_URL=http://localhost:3003
AI_SERVICE_URL=http://localhost:3004
CONTENT_SERVICE_URL=http://localhost:3005
INTERNAL_EVENT_SECRET='Internal'

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Open Source AI Services
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama2
OLLAMA_LIGHT_MODELS=phi,mistral
OLLAMA_HEAVY_MODELS=llama2,mistral-large
AI_DOMAIN_STRICT=true
# Available models: llama2, mistral, phi, codellama
# Pull models with: docker exec serein-ollama ollama pull <model-name>

COQUI_TTS_URL=http://localhost:5002
COQUI_TTS_DEFAULT_VOICE=tts_models/fr/css10/vits
COQUI_TTS_SYNTHESIZE_PATH=/api/tts
COQUI_TTS_VOICES_PATH=/api/voices
COQUI_TTS_VOICES=tts_models/fr/css10/vits

WHISPER_URL=http://localhost:9000
WHISPER_MODEL=base
WHISPER_TRANSCRIBE_PATH=/api/transcribe
# Whisper ASR Webservice
WHISPER_ENGINE=openai_whisper
# Available models: tiny, base, small, medium, large

# Vector Database (Weaviate)
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=
WEAVIATE_SCHEMA_CLASS=Book
CONTENT_SEARCH_LIMIT=20
CONTENT_SEARCH_MAX_LIMIT=50

# Application
NODE_ENV=development
PORT=3000
CONVERSATION_SERVICE_PORT=3003
API_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Monitoring (Open Source)
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3301
LOKI_URL=http://localhost:3100

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session
SESSION_TIMEOUT_MS=3600000

# CORS
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

VITE_API_BASE_URL=http://localhost
VITE_WS_BASE_URL=ws://localhost