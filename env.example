# Database
AUTH_DATABASE_URL=postgresql://serein:serein_dev_password@localhost:5432/serein_auth
USER_DATABASE_URL=postgresql://serein:serein_dev_password@localhost:5432/serein_user
CONVERSATION_DATABASE_URL=postgresql://serein:serein_dev_password@localhost:5432/serein_conversation
REDIS_URL=redis://localhost:6379

# Internal service URLs
USER_SERVICE_URL=http://localhost:3002
CONVERSATION_SERVICE_URL=http://localhost:3003
INTERNAL_EVENT_SECRET='Internal'

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Open Source AI Services
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama2
# Available models: llama2, mistral, phi, codellama
# Pull models with: docker exec serein-ollama ollama pull <model-name>

COQUI_TTS_URL=http://localhost:5002
COQUI_TTS_DEFAULT_VOICE=tts_models/fr/css10/vits

WHISPER_URL=http://localhost:5003
WHISPER_MODEL=base
# Available models: tiny, base, small, medium, large

# Vector Database (Weaviate)
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=
WEAVIATE_SCHEMA_CLASS=Book

# Application
NODE_ENV=development
PORT=3000
CONVERSATION_SERVICE_PORT=3003
API_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Monitoring (Open Source)
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3001
LOKI_URL=http://localhost:3100

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session
SESSION_TIMEOUT_MS=3600000

# CORS
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
