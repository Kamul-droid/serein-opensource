{
  "name": "@serein/shared",
  "version": "1.0.0",
  "description": "Shared utilities and types for Serein Open Source",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    },
    "./utils/logger": {
      "types": "./dist/utils/logger.d.ts",
      "require": "./dist/utils/logger.js"
    },
    "./utils/metrics": {
      "types": "./dist/utils/metrics.d.ts",
      "require": "./dist/utils/metrics.js"
    },
    "./utils/errors": {
      "types": "./dist/utils/errors.d.ts",
      "require": "./dist/utils/errors.js"
    },
    "./utils/startup": {
      "types": "./dist/utils/startup.d.ts",
      "require": "./dist/utils/startup.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "require": "./dist/types/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "test": "jest"
  },
  "dependencies": {
    "pino": "^8.17.0",
    "pino-pretty": "^11.2.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3"
  }
}

