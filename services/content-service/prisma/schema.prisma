// Prisma schema for Content Service
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("CONTENT_DATABASE_URL")
}

model BookCategory {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  books       Book[]

  @@map("book_categories")
}

model Book {
  id          String        @id @default(uuid())
  title       String
  author      String
  description String?
  isbn        String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  categoryId String?
  category   BookCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([title])
  @@index([author])
  @@map("books")
}
