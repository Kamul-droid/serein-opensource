// Prisma schema for User Service
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("USER_DATABASE_URL")
}

model UserProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  name      String?
  avatarUrl String?
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  beliefs   UserBelief[]
  interests UserInterest[]

  @@map("user_profiles")
}

model UserBelief {
  id        String   @id @default(uuid())
  profileId String
  belief    String
  createdAt DateTime @default(now())

  profile UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("user_beliefs")
}

model UserInterest {
  id        String   @id @default(uuid())
  profileId String
  interest  String
  createdAt DateTime @default(now())

  profile UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("user_interests")
}

model UserPreference {
  id                String   @id @default(uuid())
  userId            String   @unique
  voiceGender       String?  // 'male' | 'female'
  voiceId           String?
  communicationMode String?  // 'text' | 'voice' | 'both'
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("user_preferences")
}
